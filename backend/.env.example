# ============================================================
# Afhiya Leathers Backend — environment template (copy to .env)
# Never commit real secrets.
# ============================================================

NODE_ENV=development
PORT=5000

# Database — same Atlas cluster OK; use a dedicated DB name per client
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/afhiyaleathers

# Auth
JWT_SECRET=replace_with_long_random_string

# CORS — must match live storefront / admin origins (no trailing slash)
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# Admin panel login (not customer accounts)
ADMIN_EMAIL=admin@afhiyaleathers.com
ADMIN_PASSWORD=Afhiya@Admin2026

# Cloudinary
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET_KEY=
CLOUDINARY_FOLDER=afhiya-leathers

# ------------------------------------------------------------
# SMTP — required for register OTP + forgot password
# ------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your@gmail.com
SMTP_PASS=your_16_char_app_password

ALLOW_DEV_OTP=false

# --- Razorpay (test keys — switch to live for real payments) ---
RAZORPAY_KEY_ID=rzp_test_REPLACE
RAZORPAY_KEY_SECRET=REPLACE

# ------------------------------------------------------------
# Shipping partner (Shiprocket)
# ------------------------------------------------------------
SHIPPING_ENABLED=false
SHIPPING_PARTNER=shiprocket
SHIPPING_DYNAMIC_RATES=false

SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in/v1/external
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_RETURN_LOCATION=Primary
SHIPROCKET_PICKUP_PINCODE=
SHIPROCKET_RETURN_PINCODE=
SHIPROCKET_RETURN_NAME=Afhiya Leathers Warehouse
SHIPROCKET_RETURN_ADDRESS=
SHIPROCKET_RETURN_CITY=
SHIPROCKET_RETURN_STATE=
SHIPROCKET_RETURN_PHONE=
SHIPROCKET_WEBHOOK_TOKEN=
SHIPROCKET_DEFAULT_WEIGHT=0.5
SHIPROCKET_DEFAULT_LENGTH=30
SHIPROCKET_DEFAULT_BREADTH=25
SHIPROCKET_DEFAULT_HEIGHT=8

# ------------------------------------------------------------
# Partial payment (advance deposit)
# ------------------------------------------------------------
PARTIAL_PAYMENT_ENABLED=false
PARTIAL_PAYMENT_PERCENT_DEFAULT=20
PARTIAL_PAYMENT_MIN_PERCENT=10
PARTIAL_PAYMENT_MAX_PERCENT=50
PARTIAL_PAYMENT_MIN_ADVANCE=50
